# Normalize line endings to LF for all text files.
# Prevents CRLF/LF churn when editing on Windows/WSL.
* text=auto eol=lf

# Explicitly mark binary assets so git never touches their contents.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
